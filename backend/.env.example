# --- Application ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=wallet
DB_PASSWORD=wallet
DB_NAME=wallet_portal

# Run pending migrations automatically on boot (true in docker, optional locally)
DB_RUN_MIGRATIONS=true

# CORS origin for the frontend
CORS_ORIGIN=http://localhost:3001
